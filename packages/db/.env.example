DATABASE_URL=
# Dedicated shadow database for `prisma migrate dev`; must be pre-seeded with
# a stub `auth.uid()` function so migrations referencing Supabase's `auth`
# schema can be validated locally. Run `pnpm --filter @starland/db run
# shadow:bootstrap` to prepare it. See docs/adr/0001-prisma-with-supabase-rls.md.
SHADOW_DATABASE_URL=
# Runtime connection for application code: the non-superuser `app_runtime`
# role, which RLS actually applies to (unlike DATABASE_URL's `postgres`).
# See docs/adr/0001-prisma-with-supabase-rls.md.
APP_DATABASE_URL=
