# Starland environment variables.
# No variables are defined yet — later tasks add entries here as they
# introduce config (e.g. DATABASE_URL in Task 2).

# apps/admin: Supabase project API URL (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=
# apps/admin: Supabase anon/public key used by browser and server auth
# clients; RLS enforces access, so this key alone grants nothing privileged.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# apps/admin ONLY (never apps/portal — CLAUDE.md §2.2). Supabase service-role
# key, read exclusively by apps/admin/src/lib/users/supabase-admin-client.ts
# (`import 'server-only'`) to call the Admin API when creating users.
SUPABASE_SERVICE_ROLE_KEY=
